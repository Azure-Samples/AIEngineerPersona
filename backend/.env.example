# ─────────────────────────────────────────────────────────────────────────────
# Children's Story Multi-Agent — Backend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running the backend.
# Never commit .env to source control.

# Azure AI Foundry project endpoint
# Found in: Azure AI Foundry → your project → Overview → "Azure AI Foundry SDK" section
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://[FOUNDRY_PROJECT_ENDPOINT]

# Name of the chat/text generation model deployment (e.g., gpt-4o, gpt-4o-mini)
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.4

# Name of the image generation model deployment (e.g., dall-e-3, gpt-image-1)
# Used by the ArtDirectorExecutor to generate one illustration per story page.
FOUNDRY_IMAGE_MODEL_DEPLOYMENT_NAME=gpt-image-1.5

# CORS — URL of the React dev server. Change if you run frontend on a different port.
CORS_ORIGIN=http://localhost:5173

# Azure Speech Service (Text-to-Speech)
# Region where your Speech resource is deployed (e.g. eastus, westus2)
# Authentication uses DefaultAzureCredential — ensure your identity has
# the "Cognitive Services Speech User" role on the Speech resource.
AZURE_SPEECH_REGION=[REGION]
AZURE_SPEECH_ENDPOINT=https://[REGION].tts.speech.microsoft.com

# Full ARM resource ID of your Speech resource (required for AAD token auth)
# Format: /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
AZURE_SPEECH_RESOURCE_ID=/subscriptions/[SUBSCRIPTION_ID]/resourceGroups/[RESOURCE_GROUP]/providers/Microsoft.CognitiveServices/accounts/[ACCOUNT_NAME]

# ── Agent Framework Observability ──────────────────────────────────────────────
# Activates Agent Framework's built-in instrumentation (spans for agent
# invocations, LLM chat calls, and tool executions).
ENABLE_INSTRUMENTATION=true

# Includes prompts, completions, function arguments and results in span
# attributes. WARNING: only enable in dev/test — may expose PII in traces.
ENABLE_SENSITIVE_DATA=true

# ── Standard OpenTelemetry ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=children-story-studio

# ── Foundry-hosted agents (optional) ───────────────────────────────────────────
# How to host the LLM agents:
#   local   — agents are constructed in-process via OpenAIChatClient. This is
#             the default and matches all prior versions of the app.
#   foundry — agents are looked up by name in your Microsoft Foundry project.
#             You MUST run `python -m app.scripts.provision_foundry_agents`
#             once before starting the backend in this mode, otherwise the
#             startup validator will fail fast.
#
# See docs/09-guide-foundry-hosted-agents.md for the full walkthrough,
# including the source-of-truth contract: in foundry mode the agent
# definition deployed in Foundry is canonical (NOT prompts.py).
AGENT_HOSTING_MODE=local

# Required when AGENT_HOSTING_MODE=foundry. The name of the project under
# the account at FOUNDRY_PROJECT_ENDPOINT — used to build the long
# project-scoped URL (`<endpoint>/api/projects/<name>`) that the
# agent-management APIs need. Find it in the Foundry portal:
#   Foundry → your project → Overview → "Project name".
# Leave blank when AGENT_HOSTING_MODE=local; ignored in that mode.
FOUNDRY_PROJECT_NAME=

# When AGENT_HOSTING_MODE=foundry, cap reviewer fan-out at this concurrency.
# Hosted-agent calls have per-call thread/session creation overhead that
# raw chat completions don't, so we default lower than the local cap (5)
# to stay below project quotas and reduce burst-induced 429s.
# Ignored in local mode.
FOUNDRY_REVIEWER_MAX_CONCURRENT_CALLS=3
